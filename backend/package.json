{
  "name": "shopkart-backend",
  "version": "1.0.0",
  "private": true,
  "description": "ShopKart REST API — customer registration, login, JWT cookie sessions and profile",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch --watch-preserve-output index.js",
    "db:local": "node scripts/localMongo.js",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.js\""
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
