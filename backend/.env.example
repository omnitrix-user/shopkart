# Copy this file to backend/.env and fill in the values. Never commit backend/.env.

# Port the Express API listens on
PORT=5000

# MongoDB connection string (no default — you must provide one)
#   Local MongoDB:  mongodb://127.0.0.1:27017/shopkart
#   MongoDB Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/shopkart?retryWrites=true&w=majority
MONGODB_URI=

# Secret used to sign JWTs — at least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# How long a login session (JWT + cookie) lasts, in hours
JWT_EXPIRES_IN_HOURS=24

# Exact origin of the React frontend (comma-separate multiple origins, no trailing slash)
FRONTEND_URL=http://localhost:5173

# development | production
NODE_ENV=development

# --- Razorpay (TEST MODE ONLY — never use rzp_live_ keys in this project) ---
# Dashboard → switch to Test Mode → Account & Settings → API Keys → Generate Test Key.
# The Key ID is public and is sent to the browser to open Checkout.
RAZORPAY_KEY_ID=
# The Key Secret stays on the backend only. Never put it in the frontend, an API response or Git.
RAZORPAY_KEY_SECRET=

# Order-status demo endpoint (PATCH /orders/:id/status) is enabled automatically outside production.
# ENABLE_ORDER_STATUS_DEMO=false

# --- Cookie settings (defaults are correct for localhost) ---
# lax (default) works when the frontend and API share a site, e.g. localhost:5173 + localhost:5000.
# Use "none" only when the deployed frontend and API are on different sites; this forces Secure cookies.
COOKIE_SAME_SITE=lax
# Defaults to true when NODE_ENV=production, false otherwise. Secure cookies need HTTPS.
# COOKIE_SECURE=
# Optional cookie domain, e.g. .example.com when the API and frontend share a parent domain
# COOKIE_DOMAIN=

# Set to 1 when running behind a single reverse proxy / PaaS load balancer (Render, Railway, ...)
# TRUST_PROXY=1

# bcrypt work factor (default 12)
# BCRYPT_SALT_ROUNDS=12
